{
  "name": "@wcl/web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React + Vite front end for the WCL AI combat analysis platform (module navigation + streaming chat core).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
